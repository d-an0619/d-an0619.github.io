#!/bin/sh
# 이 레포는 d-an0619 계정으로만 커밋 허용
allowed="195770720+d-an0619@users.noreply.github.com"
email=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
